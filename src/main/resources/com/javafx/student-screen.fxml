<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="768.0" prefWidth="1024.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.controller.StudentController">

   <center>
      <VBox spacing="10" BorderPane.alignment="CENTER">
         <children>
            <Label text="STUDENTI - Pretraživanje">
               <font><Font name="Arial Bold" size="18.0" /></font>
               <VBox.margin><Insets bottom="0" left="10" right="10" top="10" /></VBox.margin>
            </Label>

            <GridPane hgap="10" vgap="10">
               <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>

               <columnConstraints>
                  <ColumnConstraints percentWidth="16" />
                  <ColumnConstraints percentWidth="34" />
                  <ColumnConstraints percentWidth="16" />
                  <ColumnConstraints percentWidth="34" />
               </columnConstraints>

               <children>
                  <Label text="Ime" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <TextField fx:id="firstName" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                  <Label text="Prezime" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                  <TextField fx:id="lastName" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                  <Label text="E-mail" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <TextField fx:id="email" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                  <Label text="JMBAG" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                  <TextField fx:id="jmbag" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                  <Label text="Smjer" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                  <ComboBox fx:id="course" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                  <Label text="Godina" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                  <TextField fx:id="year" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                  <Label text="ECTS (min)" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                  <TextField fx:id="ects" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                  <HBox spacing="10" GridPane.columnSpan="4" GridPane.rowIndex="5">
                     <children>
                        <Button onAction="#onSearch" text="Pretraži" />
                        <Button onAction="#onClear" text="Očisti" />
                     </children>
                  </HBox>
                  <Label fx:id="lastInsertedLabel" text="Zadnje uneseni student:" wrapText="true" GridPane.columnIndex="2" GridPane.columnSpan="2" GridPane.rowIndex="3">
                     <padding>
                        <Insets right="250.0" />
                     </padding></Label>
                  <Button mnemonicParsing="false" onAction="#onBackupStudents" text="Backup" GridPane.columnIndex="3" GridPane.rowIndex="3">
                     <GridPane.margin>
                        <Insets left="250.0" />
                     </GridPane.margin>
                  </Button>
               </children>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
            </GridPane>

            <TableView fx:id="tableStudents" prefHeight="420.0">
               <columns>
                  <TableColumn fx:id="colFirstName" prefWidth="120" text="Ime" />
                  <TableColumn fx:id="colLastName" prefWidth="120" text="Prezime" />
                  <TableColumn fx:id="colEmail" prefWidth="180" text="Email" />
                  <TableColumn fx:id="colJmbag" prefWidth="120" text="JMBAG" />
                  <TableColumn fx:id="colCourse" prefWidth="140" text="Smjer" />
                  <TableColumn fx:id="colYear" prefWidth="90" text="Godina" />
                  <TableColumn fx:id="colEcts" prefWidth="90" text="ECTS" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>
